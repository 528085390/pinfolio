{
  "name": "pinfolio",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "snapshot": "tsx server/snapshot.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm test:unit && tsx tests/snippet-test.mts",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.mts\"",
    "test:e2e": "node tests/run.mjs",
    "test:mail": "node tests/run.mjs --only=mail"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "dompurify": "^3.2.0",
    "hono": "^4.9.0",
    "imapflow": "^2.5.7",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.47",
    "marked": "^15.0.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "~4.8.4"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
