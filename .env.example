# pinfolio 环境变量（复制成 .env 放在项目根，pnpm start / pnpm start:dist 会自动读）
# 这个文件本身不要提交（.gitignore 已挡住），密码与密钥都别进版本库。

# 监听地址：本机自用留 127.0.0.1；容器里必须是 0.0.0.0
HOST=127.0.0.1
PORT=7788

# 数据目录（数据库、secret.key、备份都在这），默认 <项目根>/data
#PINBOARD_DATA=/var/lib/pinfolio

# 首次启动时设置登录密码（>=8 位）；已经设过就不再生效，改密码走设置页
#PINBOARD_PASSWORD=change-me-please

# 静态加密主密钥（32 字节 base64）。不填则自动生成 <数据目录>/secret.key。
# 丢了就解不开邮箱密码 / Kuma 口令 / 指标源 token，务必跟数据库一起备份。
#PINBOARD_SECRET=

# 挂在 HTTPS 反代后面时设 1：信任 X-Forwarded-For / X-Forwarded-Proto
# （取 XFF 最后一段作为客户端 IP，登录限流与设备列表才准）
#TRUST_PROXY=1

# 观测：接 Uptime Kuma 才需要；不接则观测页显示引导卡，其余页面照常
#KUMA_URL=http://127.0.0.1:3001
#KUMA_PASS=
#KUMA_SLUG=obs
#KUMA_FLAVOR=auto

# 服务页的部署关系（servers / services / deploys / monitors），默认 <数据目录>/services.json；
# 每次请求热读，改完刷新页面即生效。仓库只带示例 services.example.json
#SERVICES_FILE=/var/lib/pinfolio/services.json

# 便签附件的对象存储（任意 S3 兼容：Oracle OCI / Cloudflare R2 / MinIO…）。
# 五条 S3_ENDPOINT/REGION/BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY 齐了才走对象存储，缺一条就回落本机 data/uploads。
# 对象键 = S3_PREFIX + <附件id>.<后缀>，前缀留空也行（建议像 att/ 一样单独一层，桶里好认）。
# 走本地磁盘时下面几条全部留空即可；S3_DRIVER=local 可以强制忽略它们。
# 单文件上限写死在代码里（100 MB）；附件总量上限用 ATTACHMENTS_QUOTA_BYTES 调，默认 15 GB（单位字节）。
#S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#S3_REGION=ap-tokyo-1
#S3_BUCKET=pinfolio
#S3_PREFIX=att/
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#ATTACHMENTS_QUOTA_BYTES=16106127360
# 自动备份：BACKUP=0 关掉定时任务；BACKUP_HOUR 默认 3 点；BACKUP_KEEP 默认 14 份
#BACKUP=1
#BACKUP_HOUR=3
#BACKUP_KEEP=14

# 演示模式：公开演示站用。开了之后登录页会预填 PINBOARD_PASSWORD（或下面这条）的口令，
# 主界面顶部显示「这是演示站 · 数据每天重置」的横幅。自用实例别开。
#PINBOARD_DEMO=1
#PINBOARD_DEMO_PASSWORD=pinfolio-demo
#PINBOARD_DEMO_RESET=04:00 (UTC+8)
#PINBOARD_DEMO_REPO=https://github.com/528085390/pinfolio
